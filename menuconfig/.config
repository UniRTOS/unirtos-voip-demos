# External VoIP application dependencies. The application is selected by the CLI.
CONFIG_QAPP_UNIRTOS_STD_FUNC=y
CONFIG_QCM_SOCKET_ADP_FUNC=y
CONFIG_QCM_URC_FUNC=y
CONFIG_QCM_AUDIO_STREAM_FUNC=y
CONFIG_QCM_AUDIO_PCM_ONLY=y
CONFIG_QOSA_AT_PARSER_FUNC=y
CONFIG_QOSA_DATACALL_FUNC=y
CONFIG_QOSA_NW_FUNC=y
CONFIG_QOSA_SIM_FUNC=y
CONFIG_QOSA_IIC_FUNC=y
CONFIG_QOSA_AUDIO_DRIVER=y
CONFIG_QOSA_BUFFER_BLOCK_FUNC=y
CONFIG_QOSA_LINK_LIST_FUNC=y
CONFIG_QOSA_EVENT_NOTIFY_FUNC=y
# CONFIG_QCM_AUDIO_MP3_FUNC is not set
# CONFIG_QCM_AUDIO_AMR_FUNC is not set
# CONFIG_QAPP_UNIRTOS_AT_QAUDIO_CMD is not set
